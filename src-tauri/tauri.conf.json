{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DailyReport",
  "version": "0.5.1",
  "identifier": "com.cyy.dailyreport",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "日报生成",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMDQ0QkI1NzBFRjI4NUEKUldSYUtPOXd0VXNFSzdGUmIxSGVnOW8zOEJYSzNkRnVUSjJ0NVRoN3ZZTmE2bVUwNGs2bzIyK0sK",
      "endpoints": [
        "https://github.com/Cyy-0430/daily-report-app/releases/latest/download/latest.json"
      ]
    }
  }
}
